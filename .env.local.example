# Drop these in at deploy time. Until then the app runs against
# localStorage + a curated branch pool, no keys needed.

# Supabase (cross-device sync, audio storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic (parent-side branch suggestions, indexing, auto-labeling)
ANTHROPIC_API_KEY=

# OpenAI Whisper (server-side transcription for devices without Web Speech
# API — primarily iOS. Without this key, iOS users must type a note before
# each recording so AI labeling/indexing has something to read.)
OPENAI_API_KEY=
